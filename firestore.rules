
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: Insecure rules for development only.
    // These rules allow anyone to read or write to your database.
    // You should secure your database before deploying to production.
    // For example, by using authentication: `allow read, write: if request.auth != null;`
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

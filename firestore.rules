rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regla general: Denegar escritura por defecto, permitir lectura
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Colección de Clientes
    match /customers/{customerId} {
      allow create: if true;
      allow update, delete: if request.auth != null; 
    }

    // Colección de Empleados
    match /employees/{employeeId} {
      allow create: if true; 
      allow update, delete: if request.auth != null;
    }
    
    // Colección de Cobranzas
    match /collections/{collectionId} {
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Colección de Proyecciones
    match /projections/{projectionId} {
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Colección de Cotizaciones
    match /quotations/{quotationId} {
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Colección de Tickets (para futura implementación)
    match /tickets/{ticketId} {
      allow create, update, delete: if request.auth != null;
    }

    // Colección de Documentos (para futura implementación)
    match /documents/{documentId} {
      allow create, update, delete: if request.auth != null;
    }
  }
}

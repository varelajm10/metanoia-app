rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regla para la nueva colección de usuarios
    match /users/{userId} {
      // Un usuario puede leer su propio perfil.
      // Un admin puede leer el perfil de cualquier usuario.
      allow read: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Un usuario solo puede crear su propio documento.
      allow create: if request.auth.uid == userId;
      // Un usuario puede actualizar su propio perfil.
      // Un admin puede actualizar cualquier perfil (para cambiar roles, etc.).
      allow update: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Nadie puede borrar usuarios desde el cliente para mantener la integridad.
      allow delete: if false;
    }

    // --- Reglas existentes (se irán reemplazando/eliminando) ---
    match /collections/{docId} {
      allow read, write: if true;
    }

    match /projections/{docId} {
      allow read, write: if true;
    }

    match /customers/{docId} {
      allow read, write: if true;
    }
    
    match /employees/{docId} {
      allow read, write: if true;
    }

    match /quotations/{docId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /credit-requests/{docId} {
      allow read, write: if true;
    }

    match /tickets/{docId} {
      allow read, write: if true;
    }

    match /automation-executions/{docId} {
      allow read, write: if true;
    }

    match /documents/{docId} {
      allow read, write: if true;
    }

    match /inventory-items/{docId} {
      allow read, write: if true;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny: Deny read/write access to all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Customers:
    // - Allow read access to everyone to populate public-facing lists or dashboards.
    // - Allow authenticated users to create new customers.
    // - Allow authenticated users to update existing customers.
    match /customers/{customerId} {
      allow read: if true; 
      allow create, update: if request.auth != null;
    }

    // Employees:
    // - Allow read access to everyone for dashboards.
    // - Allow authenticated users to create and update employees.
    match /employees/{employeeId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // Collections (Financial Entries):
    // - Allow read access to everyone for dashboards.
    // - Allow authenticated users to create new collection entries.
    match /collections/{collectionId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Projections (Financial Entries):
    // - Allow read access to everyone for dashboards.
    // - Allow authenticated users to create new projection entries.
    match /projections/{projectionId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Quotations:
    // - Allow read access to everyone.
    // - Allow anyone to create a quotation (e.g., from a public form).
    match /quotations/{quotationId} {
      allow read: if true;
      allow create: if true;
    }

    // Add rules for other collections as needed, for example:
    // match /tickets/{ticketId} {
    //   allow read, write: if request.auth != null;
    // }
    //
    // match /documents/{documentId} {
    //   allow read, write: if request.auth != null;
    // }
  }
}

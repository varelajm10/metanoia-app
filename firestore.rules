
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read and write their own data
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Rules for 'customers' collection
    match /customers/{customerId} {
      allow read: if true; // Allow public reads for demo purposes
      allow create, update: if request.auth != null &&
                               request.resource.data.legalName is string &&
                               request.resource.data.legalName.size() > 1;
    }

    // Rules for 'employees' collection
    match /employees/{employeeId} {
      allow read: if true; // Allow public reads for demo purposes
      allow create: if request.auth != null &&
                       request.resource.data.fullName is string &&
                       request.resource.data.position is string;
    }

    // Rules for 'collections' collection
    match /collections/{collectionId} {
      allow read: if true; // Allow public reads for demo purposes
      allow create: if request.auth != null &&
                       request.resource.data.amount is number &&
                       request.resource.data.amount > 0;
    }

    // Rules for 'projections' collection
    match /projections/{projectionId} {
      allow read: if true; // Allow public reads for demo purposes
      allow create: if request.auth != null &&
                       request.resource.data.projectedAmount is number;
    }

    // Rules for 'quotations' collection
    match /quotations/{quotationId} {
      allow read: if true; // Allow public reads for demo purposes
      allow create: if request.auth != null;
    }
  }
}

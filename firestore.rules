rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // REGLA DE DESARROLLO: Permitir lectura y escritura públicas.
    // ADVERTENCIA: NO USAR EN PRODUCCIÓN.
    // Un sistema de autenticación y reglas granulares son necesarios antes de lanzar.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
